VITE_CUSTOMER_API_ORIGIN=
# Public Maps JavaScript API key. Restrict to approved HTTPS frontend referrers and Maps JavaScript API.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Server process environment only; never prefix this setting with VITE_.
# Required by npm run preview. Example: https://cks-api.example.com
CKS_GO_API_PROXY_TARGET=
VITE_CKS_GO_DEVELOPMENT_API=
VITE_CKS_GO_DEVELOPMENT_BRIDGE=

# Development only, direct HTTP 127.0.0.1 browser page. Exact origin with port, no trailing slash.
# Example: http://127.0.0.1:4312. Must be empty for every build and production runtime.
VITE_CKS_GO_LOCAL_PAYMENT_SIMULATOR_ORIGIN=
