{
  "name": "savt-cks-go-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --configLoader runner",
    "build": "tsc -b && tsc -p tsconfig.runtime.json && vite build --config vite.config.js --configLoader runner",
    "preview": "node runtime/preview.mjs",
    "test": "vitest run",
    "test:proxy": "vitest run runtime/server.test.mjs runtime/config.test.mjs src/api/client.test.ts",
    "test:proxy:browser": "node scripts/prove-customer-proxy.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.runtime.json",
    "format": "prettier --write .",
    "format:check": "node scripts/check-changed-format.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  }
}
